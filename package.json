{
  "name": "sideagent-hq",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "test": "firebase emulators:exec --config infra/firebase.json --project demo-sideagent --only firestore,auth 'pnpm -r test'",
    "emulators": "firebase emulators:start --config infra/firebase.json --project demo-sideagent --only firestore,auth",
    "demo:runner": "tsx demo/claim-and-submit.ts",
    "demo:escrow": "FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8180} tsx demo/escrow.ts",
    "field": "tsx field/src/cli.ts field",
    "compare:runners": "tsx field/scripts/compare-runners.ts",
    "sandbox:build": "docker build -t sideagent-sandbox-python:dev images/python-sandbox",
    "format": "prettier --write .",
    "schemas": "pnpm --filter @sideagent/protocol export"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.33.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
