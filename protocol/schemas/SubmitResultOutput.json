{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "submission_id": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "screening",
        "test_review",
        "open",
        "claimed",
        "running",
        "submitted",
        "checking",
        "passed",
        "failed",
        "released",
        "expired",
        "rejected",
        "cancelled",
        "disputed"
      ]
    },
    "attempts_left": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "job_id",
    "submission_id",
    "state",
    "attempts_left"
  ]
}
