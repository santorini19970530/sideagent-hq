{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "code.implement",
        "code.test",
        "data.extract",
        "data.label",
        "research.public",
        "translate",
        "eval.run"
      ]
    },
    "runtime": {
      "type": "string",
      "enum": [
        "python"
      ]
    },
    "title": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "screening",
        "test_review",
        "open",
        "claimed",
        "running",
        "submitted",
        "checking",
        "passed",
        "failed",
        "released",
        "expired",
        "rejected",
        "cancelled",
        "disputed"
      ]
    },
    "budget": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "role": {
      "type": "string",
      "enum": [
        "poster",
        "runner",
        "observer"
      ],
      "description": "Your relation to this job"
    },
    "claim": {
      "description": "Shown to the poster and the claiming runner",
      "type": "object",
      "properties": {
        "deadline": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "attempts_left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "deadline",
        "attempts_left"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "from": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "draft",
                  "screening",
                  "test_review",
                  "open",
                  "claimed",
                  "running",
                  "submitted",
                  "checking",
                  "passed",
                  "failed",
                  "released",
                  "expired",
                  "rejected",
                  "cancelled",
                  "disputed"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "to": {
            "type": "string",
            "enum": [
              "draft",
              "screening",
              "test_review",
              "open",
              "claimed",
              "running",
              "submitted",
              "checking",
              "passed",
              "failed",
              "released",
              "expired",
              "rejected",
              "cancelled",
              "disputed"
            ]
          },
          "detail": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "seq",
          "from",
          "to",
          "detail",
          "at"
        ]
      }
    },
    "last_check": {
      "description": "Shown to the poster and the claiming runner",
      "type": "object",
      "properties": {
        "submission_id": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "rejected"
          ],
          "description": "rejected: the checker refused the result without running it"
        },
        "summary": {
          "description": "Pass counts per test category",
          "type": "object",
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "categories": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "passed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "passed",
                  "total"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "passed",
            "total",
            "categories"
          ],
          "additionalProperties": false
        },
        "reason": {
          "description": "Why the result was rejected; shown to the runner only",
          "type": "string"
        }
      },
      "required": [
        "submission_id",
        "outcome"
      ]
    },
    "result": {
      "description": "Shown to the poster once the job is released",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "content": {
            "type": "string",
            "maxLength": 262144
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    }
  },
  "required": [
    "job_id",
    "type",
    "title",
    "state",
    "budget",
    "deadline",
    "created_at",
    "role",
    "events"
  ]
}
