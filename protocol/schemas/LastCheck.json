{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "submission_id": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "rejected"
      ],
      "description": "rejected: the checker refused the result without running it"
    },
    "summary": {
      "description": "Pass counts per test category",
      "type": "object",
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "categories": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "passed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "passed",
              "total"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "passed",
        "total",
        "categories"
      ],
      "additionalProperties": false
    },
    "reason": {
      "description": "Why the result was rejected; shown to the runner only",
      "type": "string"
    }
  },
  "required": [
    "submission_id",
    "outcome"
  ]
}
