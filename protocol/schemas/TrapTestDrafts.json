{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "snake_case, at most 40 characters, used in the file name"
          },
          "content": {
            "type": "string",
            "description": "A complete test file, at most 8000 characters"
          }
        },
        "required": [
          "name",
          "content"
        ]
      }
    }
  },
  "required": [
    "tests"
  ]
}
