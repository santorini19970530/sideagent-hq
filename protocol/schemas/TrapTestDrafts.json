{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tests": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,40}$",
            "description": "snake_case, used in the file name"
          },
          "content": {
            "type": "string",
            "maxLength": 8000,
            "description": "A complete test file"
          }
        },
        "required": [
          "name",
          "content"
        ]
      }
    }
  },
  "required": [
    "tests"
  ]
}
