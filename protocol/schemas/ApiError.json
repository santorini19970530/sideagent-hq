{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "invalid_request",
        "not_found",
        "unauthorized",
        "forbidden",
        "conflict",
        "invalid_state",
        "insufficient_credits",
        "spec_not_checkable",
        "job_blocked",
        "tests_invalid",
        "result_blocked",
        "rate_limited",
        "internal"
      ]
    },
    "reason": {
      "type": "string"
    },
    "fix_hint": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "reason",
    "fix_hint"
  ]
}
